{
    "name": "kings-talloc",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:emulator": "./devEmulator.sh",
        "prebuild": "node scripts/generateBuildVersion.js",
        "build": "node scripts/generateBuildVersion.js && next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "jest --testPathIgnorePatterns=firebase --testPathIgnorePatterns=e2e",
        "test:firebase": "firebase emulators:exec --only firestore --config firebase/firebase.json \"jest --config=tests/firebase/jest.firebase.config.js\"",
        "test:all": "npm run test && npm run test:firebase && npm run test:e2e",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "firebase emulators:exec --only firestore --project demo-talloc --config firebase/firebase.emulator.json 'npx playwright test'",
        "test:e2e:ui": "firebase emulators:exec --only firestore --project demo-talloc --config firebase/firebase.emulator.json 'npx playwright test --ui'"
    },
    "dependencies": {
        "@google-cloud/storage": "^7.19.0",
        "@upstash/ratelimit": "^2.0.8",
        "bootstrap": "^5.3.8",
        "browser-image-compression": "^2.0.2",
        "date-fns": "^3.6.0",
        "docxtemplater": "^3.66.7",
        "firebase": "^11.0.0",
        "firebase-admin": "^13.5.0",
        "firebase-tools": "^15.16.0",
        "googleapis": "^164.0.0",
        "lodash": "^4.17.23",
        "lodash-es": "^4.17.23",
        "luxon": "^3.7.2",
        "next": "^15.5.10",
        "next-auth": "^4.24.11",
        "pizzip": "^3.2.0",
        "playwright": "^1.59.1",
        "qs": "^6.15.0",
        "react": "^18",
        "react-big-calendar": "^1.13.1",
        "react-calendar": "^5.0.0",
        "react-csv": "^2.2.2",
        "react-datepicker": "^7.3.0",
        "react-dom": "^18",
        "react-select": "^5.8.0",
        "sanitize-html": "^2.17.3"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^4.0.0",
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.6.0",
        "dotenv": "^17.2.3",
        "eslint": "^9",
        "eslint-config-next": "^15.1.7",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jose": "^6.1.3"
    },
    "overrides": {
        "glob": "^13.0.6",
        "node-domexception": "^2.0.2"
    }
}
