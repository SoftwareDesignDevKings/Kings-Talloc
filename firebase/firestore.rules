rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to get user role from custom claims
    function getUserRole() {
      return request.auth.token.defaultRole;
    }

    // Helper function to get user roles array from custom claims
    function getUserRoles() {
      return request.auth.token.userRoles;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin (via userRoles array)
    function isAdmin() {
      return isAuthenticated() && 'admin' in getUserRoles();
    }

    // Helper function to check if user is teacher (admin)
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }

    // Helper function to check if user is tutor
    function isTutor() {
      return isAuthenticated() && getUserRole() == 'tutor';
    }

    // Helper function to check if user is student
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // Helper function to check if student owns the request (checks studentEmails array)
    function studentOwnsRequest(studentEmail) {
      // Check primitive email array (studentEmails) for access control
      // students array [{value, label}] is kept for UI only
      return studentEmail != null && 'studentEmails' in resource.data && studentEmail in resource.data.studentEmails;
    }

    // Users collection - only admins can modify roles
    match /users/{documentEmail} {
      allow read: if isAuthenticated();

      // Admins can create any user, others can only create their own account
      allow create: if isAdmin() || (isAuthenticated() && request.auth.token.email == documentEmail);

      // Admins can update any user, others can only update their own account without modifying role fields
      allow update: if isAdmin() || (isAuthenticated() && request.auth.token.email == documentEmail && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'defaultRole', 'userRoles']));
      allow delete: if isAdmin();
    }

    // Shifts collection (APPROVED shifts only - counts for payroll/hours)
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      // only admins can create/delete shifts
      allow create, delete: if isAdmin();
      // admins can update anything, tutors can only update workStatus
      allow update: if isAdmin() || (isTutor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workStatus']));
    }

    // // BACKWARDS COMPATIBILITY: events collection (APPROVED events only - counts for payroll/hours)
    // match /events/{eventId} {
    //   allow read: if isAuthenticated();
    //   // only teachers can create/delete events
    //   allow create, delete: if isTeacher();
    //   // teachers can update anything, tutors can only update workStatus
    //   allow update: if isTeacher() || (isTutor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workStatus']));
    // }

    // Email Events Queue collection (temporary queue for email notifications)
    match /emailEventsQueue/{eventId} {
      allow read: if isAuthenticated();

      // Only admins can manage email queue
      allow create, update, delete: if isAdmin();
    }

    // Student Event Requests collection (displays on calendar in red, no payroll impact)
    match /studentEventRequests/{requestId} {
      allow read: if isAuthenticated();

      // Students and teachers can create requests
      allow create: if isStudent() || isTeacher();

      // Admins and teachers can update/delete any request, students can only update/delete their own
      allow update, delete: if isTeacher() || (isStudent() && studentOwnsRequest(request.auth.token.email));
    }

    // Tutor Availabilities collection (tutor availability slots)
    match /tutorAvailabilities/{availabilityId} {
      allow read: if isAuthenticated();

      // Only tutors can create their own availabilities
      allow create: if isTutor() && request.auth.uid == request.resource.data.tutor;

      // Tutors can only update/delete their own availabilities
      allow update, delete: if isTutor() && request.auth.uid == resource.data.tutor;
    }

    // Classes collection - only admins can modify
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Subjects collection - only admins can modify
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Students collection - read-only for all authenticated users, only admins can modify
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Timesheets collection - admins can read/write, tutors can read their own
    match /timesheets/{timesheetId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

  }
}
