rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────
    // Auth helpers
    // ─────────────────────────────────────

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.get('profileId', request.auth.token.email));
    }

    function getUserRole() {
      return get(currentUserPath()).data.get('defaultRole', get(currentUserPath()).data.get('role', 'student'));
    }

    function getUserRoles() {
      return get(currentUserPath()).data.get('userRoles', []);
    }

    function isAuthenticated() {
      return request.auth != null
        // App custom tokens use the verified school email as their Firebase UID.
        && request.auth.uid == request.auth.token.email.lower()
        && request.auth.token.get('profileId', request.auth.token.email).lower() == request.auth.token.email.lower()
        && exists(currentUserPath())
        && !get(currentUserPath()).data.get('disabled', false)
        && request.auth.token.get('authVersion', '') == get(currentUserPath()).data.get('authVersion', '')
        && !exists(/databases/$(database)/documents/revokedAccounts/$(request.auth.token.email.lower()));
    }

    // ─────────────────────────────────────
    // Role helpers
    // Checks both defaultRole and userRoles array (multi-role system)
    // ─────────────────────────────────────

    // Full admin privileges
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || 'admin' in getUserRoles());
    }

    // Teacher: shares admin calendar strategy — same shift create/edit/delete rights
    function isTeacher() {
      return isAuthenticated() && (getUserRole() == 'teacher' || 'teacher' in getUserRoles());
    }

    // Tutor
    function isTutor() {
      return isAuthenticated() && (getUserRole() == 'tutor' || 'tutor' in getUserRoles());
    }

    // Coach: same field-level permissions as tutor
    function isCoach() {
      return isAuthenticated() && (getUserRole() == 'coach' || 'coach' in getUserRoles());
    }

    function isStudent() {
      return isAuthenticated() && (getUserRole() == 'student' || 'student' in getUserRoles());
    }

    // Convenience composites
    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    function isTutorOrCoach() {
      return isTutor() || isCoach();
    }

    // ─────────────────────────────────────
    // Ownership helpers
    // ─────────────────────────────────────

    // The signed profile ID may retain legacy capitals. It is already required
    // to match the authenticated email ignoring case by isAuthenticated().
    function ownEmailSpellings() {
      return [request.auth.token.email, request.auth.token.get('profileId', request.auth.token.email)];
    }

    // Check student owns a request via flat emailsList array
    function studentOwnsRequest(studentEmail) {
      return studentEmail != null
        && 'emailsList' in resource.data
        && resource.data.emailsList.hasAny(ownEmailSpellings());
    }

    // Students can acknowledge each introduction independently, without editing their profile.
    function studentAcknowledgesIntroduction(documentEmail) {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return isStudent()
        && request.auth.token.get('profileId', request.auth.token.email) == documentEmail
        && changedFields.hasOnly(['hasSeenWelcome', 'hasSeenCalendarHelp'])
        && (!changedFields.hasAny(['hasSeenWelcome'])
          || request.resource.data.get('hasSeenWelcome', false) == true)
        && (!changedFields.hasAny(['hasSeenCalendarHelp'])
          || request.resource.data.get('hasSeenCalendarHelp', false) == true);
    }

    // ─────────────────────────────────────
    // Collections
    // ─────────────────────────────────────

    // Users — admins manage updates/deletion; students can acknowledge their own introductions.
    match /users/{documentEmail} {
      allow read: if isAuthenticated();
      // Profile creation, role changes and deletion use the authenticated admin API.
      allow create, delete: if false;
      allow update: if studentAcknowledgesIntroduction(documentEmail);
    }

    match /calendarFeedSecrets/{email} {
      allow read, write: if false;
    }
    match /revokedAccounts/{email} {
      allow read, write: if false;
    }

    // Shifts — admins/teachers read all; others only read shifts they're assigned to
    match /shifts/{shiftId} {
      allow read: if isAuthenticated() && (isAdminOrTeacher()
        || resource.data.emailsList.hasAny(ownEmailSpellings()));
      // All mutations go through the authenticated scheduling service.
      allow write: if false;
    }

    // Shared transaction guard for approvals assigning the same tutor.
    match /tutorBookingGuards/{tutorEmail} {
      allow read, write: if false;
    }

    // Email Events Queue — only admins/teachers can read or write; only admins can delete
    match /emailEventsQueue/{eventId} {
      allow read, create, update: if isAdminOrTeacher();
      allow delete: if isAdmin();
    }

    // Email Notifications — admins read/write from client (queueEmailNotification uses client SDK);
    // server reads/deletes via Admin SDK which bypasses these rules
    match /emailNotifications/{shiftId} {
      allow read, create, update, delete: if isAdminOrTeacher();
    }

    // Student Event Requests — admins/teachers read all; students read their own only; tutors/coaches blocked
    match /studentEventRequests/{requestId} {
      allow read: if isAdminOrTeacher()
        || (isStudent() && studentOwnsRequest(request.auth.token.email));
      allow write: if false;
    }

    // Tutor Availabilities — tutors and coaches manage their own (tutor field = email)
    match /tutorAvailabilities/{availabilityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Recipient-only updates; decisions are written atomically by the server.
    match /bookingNotifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientEmail == request.auth.token.email;
      allow write: if false;
    }
    match /bookingNotificationState/{email} {
      allow read: if isAuthenticated() && email == request.auth.token.email;
      allow create, update: if isAuthenticated() && email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['acknowledgedAt', 'updatedAt'])
        && request.resource.data.acknowledgedAt is timestamp
        && request.resource.data.acknowledgedAt <= request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /schedulingOperations/{operationId} {
      allow read, write: if false;
    }

    // Student-safe tutor eligibility generated from Canvas rosters and admin tutor coverage.
    match /studentTutorEligibility/{studentEmail} {
      allow read: if isAdminOrTeacher()
        || (isStudent() && request.auth.token.email == studentEmail);
      allow write: if false;
    }

    // Classes — admins/teachers manage; all authenticated can read
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrTeacher();
    }

    // Subjects — admins/teachers manage; all authenticated can read
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrTeacher();
    }

    // Students — admins/teachers manage; all authenticated can read
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrTeacher();
    }

    // Canvas course whitelist — admins/teachers select which Canvas courses are synced
    match /canvasCourseWhitelist/{courseId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Canvas cache/read model — written by server-side sync via Admin SDK
    match /canvasCourses/{courseId} {
      allow read: if isAdminOrTeacher();
      allow write: if false;
    }

    match /canvasUsers/{userId} {
      allow read: if isAdminOrTeacher();
      allow write: if false;
    }

    match /canvasEnrollments/{enrollmentId} {
      allow read: if isAdminOrTeacher();
      allow write: if false;
    }

    match /canvasSyncLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /canvasSyncState/{stateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Timesheets (templates) — admin only (API route also enforces this)
    match /timesheets/{timesheetId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
